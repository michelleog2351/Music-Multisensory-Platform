    private async Task HandleRegister()
    {
        if(registerModel.Password != registerModel.ConfirmPassword)
        {


            // I want this to be visible until the user starts typing again, so I will not clear the error message immediately.
            // I will clear the error message when the user starts typing again in any of the input fields.
            // I want the error message to be visually appealing, so I will use a Bootstrap alert to display the error message.

            ErrorMessage = "Passwords do not match.";
            return;

            //   ("alert alert-danger").Remove();

            var user = new RegisterModel
            {
                FirstName = registerModel.FirstName,
                LastName = registerModel.LastName,
                Email = registerModel.Email,
                Username = registerModel.Username,
                PasswordHash = BCrypt.Net.BCrypt.HashPassword(registerModel.Password)
            };

            dB.Users.Add(user);
            await dB.SaveChangesAsync();

            ErrorMessage = null;

            // redirect to login page after successful registration
            NavigationManager.NavigateTo("/login");

        })

    }

    /// <summary>
    /// This method checks if the provided email is valid.
    /// </summary>
    /// <returns></returns>
    private bool IsEmailValid()
    {
        return !string.IsNullOrEmpty(Email) && Email.Contains("@");
    }
    private void ClearError(ChangeEventArgs args)
    {
        throw new NotImplementedException();
    }
