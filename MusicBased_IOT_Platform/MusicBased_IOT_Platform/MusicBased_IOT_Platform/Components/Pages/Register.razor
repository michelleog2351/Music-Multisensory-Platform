@page "/register"
@using Microsoft.EntityFrameworkCore
@using MusicBased_IOT_Platform.Application.Interfaces
@using MusicBased_IOT_Platform.Application.Repository
@using MusicBased_IOT_Platform.Application.Services
@using MusicBased_IOT_Platform.Data
@using MusicBased_IOT_Platform.Models
@rendermode InteractiveServer
@inject UserSessionService Session
@inject NavigationManager NavigationManager
@inject IUserRepository UserRepo
@inject IUserService UserService

<PageTitle>Register</PageTitle>

<div class="container d-flex justify-content-center align-items-center flex-grow-1">
    <div class="card p-5 mt-5 shadow rounded-4"
         style="max-width: 600px; width: 100%">
        <h2 class="text-center">Create Account</h2>
        <br />

        <EditForm Model="@registerModel" 
            OnValidSubmit="HandleRegister"
            FormName="registerForm">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="row mb-3 g-2">
                <div class="col-md-6">
                    @* <label class="visually-hidden">First Name</label> *@
                    <InputText 
                           class="form-control" 
                           @bind-Value="registerModel.FirstName"
                           placeholder="First Name" />
                </div>

                <div class="col-md-6">
                    @* <label class="visually-hidden">Last Name</label> *@
                    <InputText 
                           class="form-control"  
                           @bind-Value="registerModel.LastName"
                           placeholder="Last Name" />
                </div>
            </div>

            <div class="mb-3">
                <InputText 
                       class="form-control"  
                       type="email"
                       @bind-Value="registerModel.Email"
                       placeholder="Email address" />
            </div>

            <div class="mb-3">
                <InputText 
                       class="form-control"  
                       @bind-Value="registerModel.Username"
                       placeholder="Username" />
            </div>

            <div class="mb-3">
                <InputText class="form-control"  
                       type="password" 
                       @bind-Value="registerModel.Password"
                       placeholder="Password" />
            </div>

            <div class="mb-3">
                <InputText class="form-control"  
                       type="password" 
                       @bind-Value="registerModel.ConfirmPassword"
                       placeholder="Confirm your password" />
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    @ErrorMessage
                </div>
            }
            <div class="d-grid gap-2">
                <button class="btn btn-spotify btn-lg"
                        type="submit">Register</button>
            </div>
        </EditForm>
    </div>
</div>

@code {

    private RegisterModel registerModel = new();

    private string? ErrorMessage;

    /// <summary>
    /// The OnInitialized method checks if there is a currently logged-in user in the session.
    /// </summary>
    protected override void OnInitialized()
    {
        if (Session.CurrentUser != null)
        {
            NavigationManager.NavigateTo("/dashboard");
        }
    }

    /// <summary>
    /// The HandleRegister method is called when the user submits the registration form. 
    ///  It calls the RegisterUserAsync method of the UserService to register the user.
    /// </summary>
    /// <returns></returns>
    private async Task HandleRegister()
    {
        ErrorMessage = null;

        var result = await UserService.RegisterUserAsync(registerModel);

        if(!result.Success)
        {
            ErrorMessage = result.Error;
            return;
        }

        // redirect to login page after successful registration
        NavigationManager.NavigateTo("/login");
    }

    /// <summary>
    /// This method checks if the provided email is valid.
    /// </summary>
    /// <returns></returns>
    private bool IsEmailValid()
    {
        return !string.IsNullOrEmpty(registerModel.Email) && registerModel.Email.Contains("@");
    }

    /// <summary>
    /// The ClearError method is called when the user starts typing again in any of the input fields. It clears the error message so that 
    /// the user can see the error message only when they submit the form with invalid data.
    /// </summary>
    /// <param name="args"></param>
    private void ClearError(ChangeEventArgs args)
    {
        ErrorMessage = null;
    }


    // how do i prevent sql injection in this code?
    public void PreventSqlInjection()
    {
        // In this code, we are using Entity Framework Core which uses parameterized queries by default. 
        // This means that the user input is treated as a parameter and not as part of the SQL query, 
        // which helps to prevent SQL injection attacks.
        // However, it is still important to validate and sanitize user input to ensure that it does not contain any malicious content. 
        // For example, you can use data annotations to validate the input fields in the RegisterModel class.
        // Additionally, you should also ensure that you are using the latest version of Entity Framework Core and that you have applied all security patches.
    }
}