@page "/register"
@using MusicBased_IOT_Platform.Data
@using MusicBased_IOT_Platform.Models
@inject NavigationManager NavigationManager
@inject AppDBContext dB

<PageTitle>Register</PageTitle>

<div class="container d-flex justify-content-center align-items-center flex-grow-1">
    <div class="card p-4 shadow rounded-4"
         style="max-width: 600px; width: 100%">
        <h2 class="text-center">Create Account</h2>
        <br />

        <EditForm Model="@registerModel" 
            OnValidSubmit="HandleRegister"
            FormName="registerForm">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="row mb-3 g-2">
                <div class="col-md-6">
                    <label class="visually-hidden">First Name</label>
                    <input class="form-control" 
                           type="text" 
                           placeholder="First Name" 
                           
                           @bind="registerModel.FirstName"
                           />

                </div>

                <div class="col-md-6">
                    <label class="visually-hidden">Last Name</label>
                    <input class="form-control"  
                           type="text" 
                           placeholder="Last Name"
                           
                           @bind="registerModel.LastName"
                            />
                </div>
            </div>

            <div class="mb-3">
                <input class="form-control"  
                       type="text" 
                       placeholder="Email address"
                       
                       @bind="registerModel.Email"
                       />
            </div>

            <div class="mb-3">
                <input class="form-control"  
                       type="text" 
                       placeholder="Username" 
                       
                       @bind="registerModel.Username"                                 
                       />
            </div>

            <div class="mb-3">
                <input class="form-control"  
                       type="password" 
                       placeholder="Password"
                       
                       @bind="registerModel.Password"
                        />
            </div>

            <div class="mb-3">
                <input class="form-control"  
                       type="password" 
                       placeholder="Confirm your password"
                       
                       @bind="registerModel.ConfirmPassword"
                        />
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    @ErrorMessage
                </div>
            }
            <div class="d-grid gap-2">
                <button class="btn btn-spotify btn-lg"
                        type="submit">Register</button>
            </div>
        </EditForm>

    </div>
</div>

