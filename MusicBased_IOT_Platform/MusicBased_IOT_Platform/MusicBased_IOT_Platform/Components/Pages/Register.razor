@page "/register"
@using Microsoft.EntityFrameworkCore
@using MusicBased_IOT_Platform.Data
@using MusicBased_IOT_Platform.Models
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject AppDBContext dB

<PageTitle>Register</PageTitle>

<div class="container d-flex justify-content-center align-items-center flex-grow-1">
    <div class="card p-5 mt-5 shadow rounded-4"
         style="max-width: 600px; width: 100%">
        <h2 class="text-center">Create Account</h2>
        <br />

        <EditForm Model="@registerModel" 
            OnValidSubmit="HandleRegister"
            FormName="registerForm">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="row mb-3 g-2">
                <div class="col-md-6">
                    @* <label class="visually-hidden">First Name</label> *@
                    <InputText 
                           class="form-control" 
                           @bind-Value="registerModel.FirstName"
                           placeholder="First Name" />
                </div>

                <div class="col-md-6">
                    @* <label class="visually-hidden">Last Name</label> *@
                    <InputText 
                           class="form-control"  
                           @bind-Value="registerModel.LastName"
                           placeholder="Last Name" />
                </div>
            </div>

            <div class="mb-3">
                <InputText 
                       class="form-control"  
                       type="email"
                       @bind-Value="registerModel.Email"
                       placeholder="Email address" />
            </div>

            <div class="mb-3">
                <InputText 
                       class="form-control"  
                       @bind-Value="registerModel.Username"
                       placeholder="Username" />
            </div>

            <div class="mb-3">
                <InputText class="form-control"  
                       type="password" 
                       @bind-Value="registerModel.Password"
                       placeholder="Password" />
            </div>

            <div class="mb-3">
                <InputText class="form-control"  
                       type="password" 
                       @bind-Value="registerModel.ConfirmPassword"
                       placeholder="Confirm your password" />
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    @ErrorMessage
                </div>
            }
            <div class="d-grid gap-2">
                <button class="btn btn-spotify btn-lg"
                        type="submit">Register</button>
            </div>
        </EditForm>
    </div>
</div>

@code {

    private string? ErrorMessage;


    private RegisterModel registerModel = new();

    /// <summary>
    /// This method checks if the registration form is valid.
    /// </summary>
    /// <returns></returns>
    // private bool IsFormValid()
    // {
    //     return !string.IsNullOrEmpty(registerModel.FirstName)
    //         && !string.IsNullOrEmpty(registerModel.LastName)
    //         && !string.IsNullOrEmpty(registerModel.Email)
    //         && !string.IsNullOrEmpty(registerModel.Username)
    //         && !string.IsNullOrEmpty(registerModel.Password)
    //         && !string.IsNullOrEmpty(registerModel.ConfirmPassword)
    //         && registerModel.Password == registerModel.ConfirmPassword
    //         && IsEmailValid();
    // }


    /// <summary>
    /// This method handles the registration process when the user submits the form.
    /// </summary>
    /// <returns></returns>
    private async Task HandleRegister()
    {
        ErrorMessage = null;

        // I want this to be visible until the user starts typing again, so I will not clear the error message immediately.
        // I will clear the error message when the user starts typing again in any of the input fields.
        // I want the error message to be visually appealing, so I will use a Bootstrap alert to display the error message.

        // ErrorMessage = "Passwords do not match.";
        // return;

        //   ("alert alert-danger").Remove();

        var existingUser = await dB.Users
        .FirstOrDefaultAsync(u => u.Username == registerModel.Username);

        if (existingUser != null)
        {
            ErrorMessage = "Username already exists.";
            return;
        }

        var user = new UserAccount
            {
                FirstName = registerModel.FirstName,
                LastName = registerModel.LastName,
                Email = registerModel.Email,
                Username = registerModel.Username,
                PasswordHash = BCrypt.Net.BCrypt.HashPassword(registerModel.Password)
            };

        dB.Users.Add(user);
        await dB.SaveChangesAsync();

         ErrorMessage = null;

        // redirect to login page after successful registration
        NavigationManager.NavigateTo("/login");
    }

    /// <summary>
    /// This method checks if the provided email is valid.
    /// </summary>
    /// <returns></returns>
    private bool IsEmailValid()
    {
        return !string.IsNullOrEmpty(registerModel.Email) && registerModel.Email.Contains("@");
    }

    /// <summary>
    /// The ClearError method is called when the user starts typing again in any of the input fields. It clears the error message so that 
    /// the user can see the error message only when they submit the form with invalid data.
    /// </summary>
    /// <param name="args"></param>
    private void ClearError(ChangeEventArgs args)
    {
        ErrorMessage = null;
    }
}