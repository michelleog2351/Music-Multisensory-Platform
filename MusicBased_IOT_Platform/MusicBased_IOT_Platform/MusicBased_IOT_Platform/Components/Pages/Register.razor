    // Debugging
    private async Task HandleRegister()
    {
        try
        {
            var user = new UserAccount
            {
                FirstName = registerModel.FirstName,
                LastName = registerModel.LastName,
                Email = registerModel.Email,
                Username = registerModel.Username,
                PasswordHash = BCrypt.Net.BCrypt.HashPassword(registerModel.Password)
            };

            dB.Users.Add(user);
            await dB.SaveChangesAsync();

            NavigationManager.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }


    /// <summary>
    /// This method checks if the provided email is valid.
    /// </summary>
    /// <returns></returns>
    private bool IsEmailValid()
    {
        return !string.IsNullOrEmpty(registerModel.Email) && registerModel.Email.Contains("@");
    }

    /// <summary>
    /// The ClearError method is called when the user starts typing again in any of the input fields. It clears the error message so that 
    /// the user can see the error message only when they submit the form with invalid data.
    /// </summary>
    /// <param name="args"></param>
    private void ClearError(ChangeEventArgs args)
    {
        ErrorMessage = null;
    }
