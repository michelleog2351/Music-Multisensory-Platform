 *@
 <h1>Welcome Back Michelle!</h1>
<h3>Music Platform</h3>


@* Search for mood and displayed music track. When searchbox is clicked modal-like overlay *@

<div class="input-group mb-3">
    <input type="search" 
           class="form-control"
           name="moodSearch" 
           placeholder="Search for your mood..." 
           autocomplete="on" 
           @onclick="OpenSearchModal" />
</div>

    <br />


@* <button class="btn btn-outline-primary btn-sm" @onclick="DisplayArtist">Longing</button>
 *@
@* <input type="text" name="search" placeholder="So, how are you feeling today?" autocomplete="on" /> *@

@if (isSearchModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1 ">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Find Music by Mood</h5>
                    <button type="button" class="btn-close" @onclick="CloseSearchModal"></button>
                </div>

                <div class="modal-body">

                    <!-- Search Box inside modal -->
                    <input type="search"
                           class="form-control mb-3"
                           placeholder="Search by mood e.g. calm, happy..." />

                    <!-- Recently Searched -->
                    @* If you have searched previously, these are the text bubbles showing your recent searches*@
                    <h6>Recently Searched</h6>
                    <div class="d-flex gap-2 flex-wrap mb-3">
                        <span class="badge bg-secondary">Happy</span>
                        <span class="badge bg-secondary">Calm</span>
                        <span class="badge bg-secondary">Hopeful</span>
                    </div>

                    <!-- Search Discovery -->
                    @* This section will help users to find popular categories without having to type a search query *@

                    <h6>Popular Searches</h6>
                    <div class="d-flex gap-2 flex-wrap">
                        <button class="btn btn-outline-primary btn-sm">Longing</button>
                        <button class="btn btn-outline-primary btn-sm">Empowered</button>
                        <button class="btn btn-outline-primary btn-sm">Goofy</button>
                        <button class="btn btn-outline-primary btn-sm">Springtime Bops</button>
                    </div>

                </div>

            </div>
        </div>
    </div>

    <!-- Backdrop -->
    <div class="modal-backdrop fade show"></div>
}

@* Dropdown music or select from available button selection options *@
<select class="form-select">
    <option value="happy">Happy</option>
    <option value="sad">Sad</option>
    <option value="energetic">Energetic</option>
    <option value="relaxed">Relaxed</option>
</select>

<button class="btn btn-primary">Get Music Suggestions</button>


@* @if (isLoading)
{
    <p>Loading...</p>
} *@


@code {

    @* prompt the user to perform an action if the system has been left inactive after 30 secs i.e. "Play a music track!" or "Search for your mood!" *@

    private System.Timers.Timer? inactivityTimer;

    /// <summary>
    /// This method is called when the component is initialised.
    /// </summary>
    protected override void OnInitialized()
    {
        inactivityTimer = new System.Timers.Timer(30000); // 30 seconds
        inactivityTimer.Elapsed += OnInactivityElapsed!;
        inactivityTimer.AutoReset = false; // Only trigger once
        inactivityTimer.Start();
    }

    /// <summary>
    /// This method is called when the inactivity timer elapses.
    /// </summary>
    /// <param name="sender"></param>
    /// <param name="e"></param>
    private void OnInactivityElapsed(object sender, System.Timers.ElapsedEventArgs e)
    {
        InvokeAsync(() =>
        {
            // Show prompt to the user
            Console.WriteLine("Hey! It's been a while. How about playing a music track or searching for your mood?");
        });
    }

    /// <summary>
    /// This method resets the inactivity timer.
    /// </summary>
    private void ResetInactivityTimer()
    {
        inactivityTimer!.Stop();
        inactivityTimer.Start();
    }

    /// <summary>
    /// This method is called when the component is disposed.
    /// </summary>
    public void Dispose()
    {
        inactivityTimer?.Dispose();
    }

    /// <summary>
    /// This method is called when the search box is clicked.
    /// </summary>
    private void OnSearchBoxClicked()
    {
        ResetInactivityTimer();
    }

    @* Search box *@
    private string searchQuery = string.Empty;

    // searchQuery.Contains("happy") || searchQuery.Contains("joy") || searchQuery.Contains("excited") ? "Happy" : "Sad" : "Relaxed" : "Energetic";

    private bool isSearchModalOpen = false;

    /// <summary>
    /// This method is called to open the search modal.
    /// </summary>
    private void OpenSearchModal()
    {
        isSearchModalOpen = true;
    }

    /// <summary>
    /// This method is called to close the search modal.
    /// </summary>
    private void CloseSearchModal()
    {
        isSearchModalOpen = false;
    }
    private void DisplayArtist(MouseEventArgs args)
    {
        throw new NotImplementedException();
    }
}
