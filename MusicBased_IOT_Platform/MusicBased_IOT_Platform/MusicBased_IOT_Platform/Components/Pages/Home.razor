@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using MusicBased_IOT_Platform.Application.Interfaces
@using MusicBased_IOT_Platform.Application.Interfaces.Spotify
@using MusicBased_IOT_Platform.Models

<PageTitle>Home</PageTitle>
<br />
<br />
<h1>Welcome Back Michelle!</h1>
<h3>Music Platform</h3>

    <input id="moodSearch"
           type="search"
           class="form-control"
           placeholder="Search for your mood..."  
           readonly
           @onfocus="OpenSearchModal" />


@if (isSearchModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation="true">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Find Music by Mood</h5>
                    <button type="button" class="btn-close" @onclick="CloseSearchModal"></button>
                </div>

                <div class="modal-body">
                    <div class="position-relative">
                        <input type="search"
                               class="form-control mb-3"
                               placeholder="Search tracks..."
                               @bind="searchTerm"
                               @oninput="OnSearchChanged" />

                        @if (searchResults.Any())
                        {
                            <div class="position-absolute bg-white shadow rounded w-100 mt-1" style="z-index:1055;">
                                @foreach (var track in searchResults.Take(5))
                                {
                                    <div class="suggestion-item p-2"
                                         style="cursor:pointer;"
                                         @onclick="() => SelectTrack(track)">
                                        @track.Name - @track?.Artists[0].Name
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Recently Searched -->
                     @* If you have searched previously, these are the text bubbles showing your recent searches *@
                    <h6>Recently Searched</h6>
                    <div class="d-flex gap-2 flex-wrap mb-3">
                        <span class="badge bg-secondary">Happy</span>
                        <span class="badge bg-secondary">Calm</span>
                        <span class="badge bg-secondary">Hopeful</span>
                    </div>

                    <!-- Search Discovery -->
                    @* This section will help users to find popular categories without having to type a search query *@

                    <h6>Popular Searches</h6>
                    <div class="d-flex gap-2 flex-wrap">
                        <button class="btn btn-outline-primary btn-sm">Longing</button>
                        <button class="btn btn-outline-primary btn-sm">Empowered</button>
                        <button class="btn btn-outline-primary btn-sm">Goofy</button>
                        <button class="btn btn-outline-primary btn-sm">Springtime Bops</button>
                    </div>

                </div>

            </div>
        </div>
    </div>

    <!-- Backdrop -->
    <div class="modal-backdrop fade show"></div>
}

@* Dropdown music or select from available button selection options *@
<select class="form-select">
    <option value="happy">Happy</option>
    <option value="sad">Sad</option>
    <option value="energetic">Energetic</option>
    <option value="relaxed">Relaxed</option>
</select>

<button class="btn btn-spotify">Get Music Suggestions </button>

@* @if (isLoading)
{
    <p>Loading...</p>
} *@


@if (releases != null)
{
    var index = 1;

    foreach (var album in releases.Albums!.Items!)
    {
        <div class="app-card mb-3">
            <div>
                <h5>
                    <span class="track-number">@index</span>
                    @album.Name
                </h5>
                <p class="text-muted">
                    @album.Artists![0].Name
                </p>
            </div>
        </div>

        index++;
    }
}



@code {

    [Inject]
    public ISpotifyDataService Spotify { get; set; } = default!;

    private string searchTerm = "";
    private List<Item> searchResults = new();
    private List<Track>? filteredTracks = new();

    private CancellationTokenSource? _cts;

    // prompt the user to perform an action if the system has been left inactive after 30 secs i.e. "Play a music track!" or "Search for your mood!"

    private System.Timers.Timer? inactivityTimer;

    private NewReleases? releases;

    private Tracks? tracks;

    List<Track>? allTracks;

    /// <summary>
    /// This method is called when the component is initialised.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {

        // allTracks = releases?.Albums?.Items?
        // .SelectMany(a => a.Tracks!.Items)
        // .ToList() ?? new();


        releases = await Spotify.GetNewAlbumReleases();

        // tracks = await ISpotifyDataService.GetTrack(10);

        inactivityTimer = new System.Timers.Timer(30000); // 30 seconds
        inactivityTimer.Elapsed += OnInactivityElapsed!;
        inactivityTimer.AutoReset = false; // Only trigger once
        inactivityTimer.Start();
    }

    /// <summary>
    /// This method is called when the inactivity timer elapses.
    /// </summary>
    /// <param name="sender"></param>
    /// <param name="e"></param>
    private void OnInactivityElapsed(object sender, System.Timers.ElapsedEventArgs e)
    {
        InvokeAsync(() =>
        {
            // Show prompt to the user
            Console.WriteLine("Hey! It's been a while. How about playing a music track or searching for your mood?");
        });
    }

    /// <summary>
    /// This method resets the inactivity timer.
    /// </summary>
    private void ResetInactivityTimer()
    {
        inactivityTimer!.Stop();
        inactivityTimer.Start();
    }

    /// <summary>
    /// This method is called when the component is disposed.
    /// </summary>
    public void Dispose()
    {
        inactivityTimer?.Dispose();
    }

    /// <summary>
    /// This method is called when the search box is clicked.
    /// </summary>
    private void OnSearchBoxClicked()
    {
        ResetInactivityTimer();
    }

    private void SelectTrack(Item track)
    {
        searchTerm = track.Name!;
        searchResults.Clear();

        CloseSearchModal();
    }

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";

        _cts?.Cancel();
        _cts = new CancellationTokenSource();

        try
        {
            await Task.Delay(400, _cts.Token); // 400ms debounce

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var results = await Spotify.Search(searchTerm, "track");

                searchResults = results.Tracks?.Items?.ToList()
                                ?? new List<Item>();
            }
            else
            {
                searchResults.Clear();
            }
        }
        catch (TaskCanceledException)
        {
            // User kept typing — ignore
        }
    }

    private string SearchTerm
    {
        get => searchTerm;
        set
        {
            searchTerm = value;
            FilterTracks();
        }
    }

    private void FilterTracks()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredTracks!.Clear();
            return;
        }

        filteredTracks = allTracks?
            .Where(t => t.Name!.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
            .Take(8)
            .ToList();
    }

    @* Search box *@
    private string searchQuery = string.Empty;

    // searchQuery.Contains("happy") || searchQuery.Contains("joy") || searchQuery.Contains("excited") ? "Happy" : "Sad" : "Relaxed" : "Energetic";

    private bool isSearchModalOpen = false;

    /// <summary>
    /// This method is called to open the search modal.
    /// </summary>
    private void OpenSearchModal()
    {
       // Console.WriteLine("OPEN CLICKED");
        isSearchModalOpen = true;
    }

    /// <summary>
    /// This method is called to close the search modal.
    /// </summary>
    private void CloseSearchModal()
    {
        isSearchModalOpen = false;
    }

    // private void DisplayArtist(MouseEventArgs args)
    // {
    //     throw new NotImplementedException();
    // }
}
