@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject UserSessionService UserSession

@using MusicBased_IOT_Platform.Application.Interfaces
@using MusicBased_IOT_Platform.Application.Interfaces.Spotify
@using MusicBased_IOT_Platform.Application.Services
@using MusicBased_IOT_Platform.Models

<PageTitle>Home</PageTitle>
<br />
<br />
@inject UserSessionService Session

@if (Session.CurrentUser != null)
{
    <div class="alert alert-success">
        <h1>Welcome back @Session.CurrentUser.FirstName!</h1>
    </div>
}

<h3 style="color: darkgray">Music MultiSensory Platform</h3>

<div class="d-flex gap-2">
    <input class="form-control mt-3 p-4 d-flex ali"
           id="moodSearch"
           type="search"
           placeholder="Search for your mood..."  
           readonly
           @onfocus="OpenSearchModal" />

    @* Dropdown music or select from available button selection options *@
@*     <select class="form-select">
        <option value="happy">Happy</option>
        <option value="sad">Sad</option>
        <option value="energetic">Energetic</option>
        <option value="relaxed">Relaxed</option>
    </select>

    <button class="btn btn-spotify">Get Music Suggestions </button> *@
</div>

<button class="btn btn-info scroll-to-top-btn" title="Scroll to Top">
    <h1>↑</h1>
</button>

@if (isSearchModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation="true">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Find Music by Mood</h5>
                    <button type="button" class="btn-close" @onclick="CloseSearchModal"></button>
                </div>

                
                    <div class="search-container">
                        <input type="search"
                               class="form-control form-control-lg mb-3 mt-5 p-3"
                               placeholder="Search tracks..."

                               @bind="searchTerm"
                               @oninput="OnSearchChanged" />

                        @* @if (selectedTrack?.PreviewUrl != null)
                        {
                            <div class="mt-3">
                                <h6>@selectedTrack.Name - @selectedTrack.Artists[0].Name</h6>

                                <audio controls style="width:100%">
                                    <source src="@selectedTrack.PreviewUrl" type="audio/mpeg">
                                </audio>
                            </div>
                        } *@

                        @if (selectedTrack != null)
                        {
                            <iframe src="https://open.spotify.com/embed/track/@selectedTrack.Id"
                                    width="100%"
                                    height="80"
                                    frameborder="0"
                                    allow="encrypted-media">
                            </iframe>
                        }

                        @if (searchResults.Any())
                        {
                            <div class="position-absolute suggestions bg-white shadow rounded w-100 mt-1" style="z-index:1055;">
                                @foreach (var track in searchResults.Take(5))
                                {
                                    <div class="suggestion-item"
                                         style="cursor:pointer;"
                                         @onclick="() => SelectTrack(track)">
                                        @track.Name - @track?.Artists![0].Name
                                    </div>
                                }
                            </div>
                        }
                      
                

                    <!-- Recently Searched -->
                     @* If you have searched previously, these are the text bubbles showing your recent searches *@
                    <h6 class="mt-4">Recently Searched</h6>
                    <div class="d-flex gap-2 flex-wrap mb-3">
                        <span class="badge bg-secondary">Happy</span>
                        <span class="badge bg-secondary">Calm</span>
                        <span class="badge bg-secondary">Hopeful</span>
                    </div>

                    <!-- Search Discovery -->
                    @* This section will help users to find popular categories without having to type a search query *@

                    @foreach (var mood in suggestedMoods)
                    {
                        <button class="btn btn-outline-primary btn-sm">
                            @mood
                        </button>
                @* @onclick= "() => SearchByMood(mood)" > *@

                    }

                    @if (detectedMood == "stressed")
                    {
                    suggestedMoods = new () { "Calm", "Ambient", "Lo-fi" };
                    }

                    <h6 class="mt-4">Popular Searches</h6>
                    <div class="d-flex gap-2 flex-wrap">
                        <button class="btn btn-outline-primary btn-sm">Longing</button>
                        <button class="btn btn-outline-primary btn-sm">Empowered</button>
                        <button class="btn btn-outline-primary btn-sm">Goofy</button>
                        <button class="btn btn-outline-primary btn-sm">Springtime Bops</button>
                    </div>

                </div>
               
            </div>
        </div>
    </div>

    <!-- Backdrop -->
    <div class="modal-backdrop fade show"></div>
}

<br />
<div class="d-flex gap-2 align-items-center justify-content-end mb-3">
