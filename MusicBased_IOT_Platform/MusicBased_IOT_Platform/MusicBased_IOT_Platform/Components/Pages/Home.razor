{
    <p>Loading...</p>
} *@


<div @key="currentView" class="view-container slide-in @(currentView == TrackViewMode.Gallery ? "fade-in" : "fade-in")">

    @if (currentView == TrackViewMode.List)
    {
        if (releases?.Albums?.Items == null)
        {
                <p>No tracks available yet...</p>
        }
        else
        {
            @foreach (var track in releases!.Albums!.Items!)
            {
                <div class="list-item d-flex justify-content-between align-items-center p-3 border-bottom">
                        <div class="fw-bold">@track.Name</div>
                       @*  <img src="@track?.Images?.FirstOrDefault()?.Url"
                             class=""
                             style="height:100px; object-fit:cover;" /> *@
                        <small class="text-muted">
                            @(track?.Artists?.FirstOrDefault()?.Name ?? "Unknown Artist")
                        </small>
                        </div>

                        <div class="d-flex align-items-center gap-3">
                            <img src="@track?.Images?.FirstOrDefault()?.Url" 
                                 style="width: 60px; height:60px; object-fit:cover; border-radius: 8px;" />

                            <a href="@track?.ExternalUrls?.Spotify"
                               target="_blank"
                               class="btn btn-sm btn-outline-primary  rounded-circle"
                               style="width:40px;height:40px;">
                                ▶
                            </a>

                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-primary">▶</button>
                                <button class="btn btn-sm btn-outline-danger rounded-circle"
                                        style="width:40px;height:40px;">❤️
                                </button>

                            </div>
                        </div>
            }
        }
    }
    else if (currentView == TrackViewMode.Gallery)
    {
        <div class="row g-4">
            @if (releases?.Albums?.Items != null)
            {
                foreach (var track in releases.Albums.Items)
                {
                    <div class="col-md-4">
                        <div class="card shadow-sm h-100">

                            <img src="@track?.Images?.FirstOrDefault()?.Url"
                                 class="card-img-top"
                                 style="height:200px;object-fit:cover;" />

                            <div class="card-body text-center">

                                <h5 class="card-title">@track!.Name</h5>

                                <p class="text-muted">
                                    @(track.Artists?.FirstOrDefault()?.Name ?? "Unknown Artist")
                                </p>

                                <div class="d-flex justify-content-center gap-3 mt-3">
                                    <button class="btn btn-primary">▶ Play</button>
                                    <button class="btn btn-outline-danger">❤️</button>
                                </div>

                                @* <iframe style="border-radius:12px"
                                        src="https://open.spotify.com/embed/track/@track.Id"
                                        width="100%"
                                        height="80"
                                        frameborder="0"
                                        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture">
                                </iframe> *@

                                <a href="@track.ExternalUrls?.Spotify"
                                   target="_blank"
                                   class="btn btn-sm btn-outline-primary">
                                    ▶
                                </a>

                                <iframe src="https://open.spotify.com/embed/track/@track.Id"
                                        width="300"
                                        height="380"
                                        frameborder="0"
                                        allow="autoplay; clipboard-write; encrypted-media">
                                </iframe>

                            </div>

                        </div>
                    </div>
                }
            }
        </div>
    }

</div>

@if (releases != null)
{
    var index = 1;

    @if (releases?.Albums?.Items != null)
    {
        foreach (var album in releases.Albums.Items)
        {
            <div class="app-card mb-3">
                <div>
                    <h5>
                        <span class="track-number">@index</span>
                        @album.Name
                    </h5>
                    <img src="@album?.Images?.FirstOrDefault()?.Url"
                         class=""
                         style="height:100px; object-fit:cover;"/>
                    <p class="text-muted">
                        @album?.Artists![0].Name
                    </p>
                </div>
            </div>

            index++;
        }
    }
}

@if (NowPlaying != null)
{
    <div class="player-sidebar">
        <h5>@NowPlaying.Name</h5>
        @* <p>@NowPlaying.Artist</p> *@

        @* <button @onclick="Pause">Pause</button> *@
    </div>
}

@if (recalibrationRequired)
{
    <div class="alert alert-warning">
        Your biometric baseline needs recalibration.
        Please remain calm and click recalibrate.
    </div>

    <button class="btn btn-primary" @onclick="Recalibrate">
        Recalibrate Biometrics
    </button>
}

@if (showMoodPrompt)
{
    <div class="mood-toast">
        <div class="toast-header fw-bold">
            Hey Michelle!
        </div>

        <div class="toast-body">
            Based on your recent activity, you may be feeling @detectedMood.
            Would you like to listen to something calming?
        </div>

        <div class="d-flex flex-column gap-2 mt-2">
            <button class="btn btn-success"
                    @onclick="ConfirmMood">
                Yes Please!
            </button>

            <button class="btn btn-outline-secondary"
                    @onclick="RejectMood">
                Nope, just exercising!
            </button>
        </div>
    </div>
}


@code {

    [Inject]
    public ISpotifyDataService Spotify { get; set; } = default!;

    [Inject]
    public MoodCalibrationService MoodCalibrationService { get; set; } = default!;

    private string searchTerm = "";
    private List<Item> searchResults = new();
    private List<Track>? filteredTracks = new();

    private CancellationTokenSource? _cts;

    // prompt the user to perform an action if the system has been left inactive after 30 secs i.e. "Play a music track!" or "Search for your mood!"

    private System.Timers.Timer? inactivityTimer;

    private NewReleases? releases;

    private MusicMoodResult? moodResult;
    private bool recalibrationRequired;

    private Item? selectedTrack;

    private bool showMoodPrompt = false;
    private string detectedMood = "";

    Track? NowPlaying;

    async Task OnPlayClicked(Track track)
    {
        await Spotify.PlayTrack(track.Uri!);
        NowPlaying = track;
    }

    /// <summary>
    /// This method is called when the component is initialised.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {

        // allTracks = releases?.Albums?.Items?
        // .SelectMany(a => a.Tracks!.Items)
        // .ToList() ?? new();


        releases = await Spotify.GetNewAlbumReleases();

        // tracks = await ISpotifyDataService.GetTrack(10);

        inactivityTimer = new System.Timers.Timer(30000); // 30 seconds
        inactivityTimer.Elapsed += OnInactivityElapsed!;
        inactivityTimer.AutoReset = false; // Only trigger once
        inactivityTimer.Start();

        recalibrationRequired = await MoodCalibrationService.IsRecalibrationRequiredAsync();

        if (!recalibrationRequired)
        {
            moodResult = await MoodCalibrationService.GenerateMoodMusicAsync();
        }
    }

    private async Task Recalibrate()
    {
        // await MoodCalibrationService.RecalibrateAsync();
        // recalibrationRequired = false;
        moodResult = await MoodCalibrationService.RecalibrateAsync();
    }

    /// <summary>
    /// This method is called when the inactivity timer elapses.
    /// </summary>
    /// <param name="sender"></param>
    /// <param name="e"></param>
    private void OnInactivityElapsed(object sender, System.Timers.ElapsedEventArgs e)
    {
        InvokeAsync(() =>
        {
            // Show prompt to the user
            Console.WriteLine("Hey! It's been a while. How about playing a music track or searching for your mood?");
        });
    }

    /// <summary>
    /// This method resets the inactivity timer.
    /// </summary>
    private void ResetInactivityTimer()
    {
        inactivityTimer!.Stop();
        inactivityTimer.Start();
    }

    /// <summary>
    /// This method is called when the component is disposed.
    /// </summary>
    public void Dispose()
    {
        inactivityTimer?.Dispose();
    }

    /// <summary>
    /// This method is called when the search box is clicked.
    /// </summary>
    private void OnSearchBoxClicked()
    {
        ResetInactivityTimer();
    }

    private void SelectTrack(Item track)
    {
        selectedTrack = track;
        searchTerm = track.Name!;
        searchResults.Clear();

        //CloseSearchModal();
    }

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";

        _cts?.Cancel();
        _cts = new CancellationTokenSource();

        try
        {
            await Task.Delay(400, _cts.Token); // 400ms debounce

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var results = await Spotify.Search(searchTerm, "track");

                searchResults = results.Tracks?.Items?.ToList()
                                ?? new List<Item>();
            }
            else
            {
                searchResults.Clear();
            }
        }
        catch (TaskCanceledException)
        {
            // User kept typing — ignore
        }
    }

    private string SearchTerm
    {
        get => searchTerm;
        set
        {
            searchTerm = value;
            FilterTracks();
        }
    }

    private void FilterTracks()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredTracks!.Clear();
            return;
        }

        // filteredTracks = allTracks?
        //     .Where(t => t.Name!.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        //     .Take(8)
        //     .ToList();
    }

    @* Search box *@
    private string searchQuery = string.Empty;

    // searchQuery.Contains("happy") || searchQuery.Contains("joy") || searchQuery.Contains("excited") ? "Happy" : "Sad" : "Relaxed" : "Energetic";

    private bool isSearchModalOpen = false;

    /// <summary>
    /// This method is called to open the search modal.
    /// </summary>
    private void OpenSearchModal()
    {
        // Console.WriteLine("OPEN CLICKED");
        isSearchModalOpen = true;
    }

    /// <summary>
    /// This method is called to close the search modal.
    /// </summary>
    private void CloseSearchModal()
    {
        isSearchModalOpen = false;
    }

    /// <summary>
    /// The TrackView m
    /// </summary>
    private enum TrackViewMode
    {
        List,
        Gallery
    }

    private TrackViewMode currentView = TrackViewMode.Gallery;

    private void SetView(TrackViewMode mode)
    {
        currentView = mode;
    }

    /// <summary>
    /// The <c>ConfirmMood</c> method is called when the user confirms that they want to listen to music based on their detected mood.
    /// </summary>
    /// <returns></returns>
    private async Task ConfirmMood()
    {
        showMoodPrompt = false;

        searchTerm = detectedMood;
        var results = await Spotify.Search(searchTerm, "track");
        searchResults = results.Tracks?.Items?.ToList()
                        ?? new();
    }

    private void RejectMood()
    {
        showMoodPrompt = false;

        // Option 1: open search modal
        isSearchModalOpen = true;

        // Option 2: show alternative moods
        suggestedMoods = new List<string> { "Energetic", "Workout", "Focus" };
    }

    private List<string> suggestedMoods = new()
    {
        "Calm", "Happy", "Focus"
    };

    // private void DisplayArtist(MouseEventArgs args)
    // {
    //     throw new NotImplementedException();
    // }
}

