@code {

    [Inject]
    public ISpotifyDataService Spotify { get; set; } = default!;

    [Inject]
    public MoodCalibrationService MoodCalibrationService { get; set; } = default!;

    private string searchTerm = "";
    private List<Item> searchResults = new();
    private List<Track>? filteredTracks = new();

    private CancellationTokenSource? _cts;

    // prompt the user to perform an action if the system has been left inactive after 30 secs i.e. "Play a music track!" or "Search for your mood!"

    private bool isLoading;
    private System.Timers.Timer? inactivityTimer;

    private NewReleases? releases;

    private MusicMoodResult? moodResult;
    private bool recalibrationRequired;

    private Item? selectedTrack;

    private bool showMoodPrompt = false;
    private string detectedMood = "";

    Item? NowPlaying;

    private List<UiTrack> favourites = new();

    private bool _spotifyReady = false;

    private void AddToFavourites(UiTrack track)
    {
        if (!favourites.Any(t => t.Id == track.Id))
            favourites.Add(track);
    }

    private async Task ConnectToSpotify()
    {
        await Session.LoadUserAsync();

        if (Session.CurrentUser == null)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        var url = SpotifyService.GetSpotifyLoginUrl();
        NavigationManager.NavigateTo(url, true);
    }

    async Task OnPlayClicked(Item track)
    {
        await Session.LoadUserAsync();

        var token = Session.CurrentUser?.SpotifyAccessToken;

        if (string.IsNullOrEmpty(token))
            return;

        await JS.InvokeVoidAsync(
            "playTrackWeb",
            token,
            track.Uri
        );

        NowPlaying = track;
    }

    async Task Pause()
    {
        await JS.InvokeVoidAsync("pauseTrack");
    }

    async Task Resume()
    {
        await JS.InvokeVoidAsync("resumeTrack");
    }

    private async Task TestPlay()
    {
        await Session.LoadUserAsync();

        var token = Session.CurrentUser?.SpotifyAccessToken;

        await JS.InvokeVoidAsync(
            "playTrackWeb",
            token,
            "spotify:track:59oIHy7WdyoWY8LkUGX3O0" // random test track
        );
    }

    /// <summary>
    /// This method is called when the component is initialised.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {

        // allTracks = releases?.Albums?.Items?
        // .SelectMany(a => a.Tracks!.Items)
        // .ToList() ?? new();


        releases = await Spotify.GetNewAlbumReleases();

        // tracks = await ISpotifyDataService.GetTrack(10);

        inactivityTimer = new System.Timers.Timer(30000); // 30 seconds
        inactivityTimer.Elapsed += OnInactivityElapsed!;
        inactivityTimer.AutoReset = false; // Only trigger once
        inactivityTimer.Start();

        recalibrationRequired = await MoodCalibrationService.IsRecalibrationRequiredAsync();

        if (!recalibrationRequired)
        {
            moodResult = await MoodCalibrationService.RecalibrateAsync();
        }
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _spotifyReady)
            return;

        _spotifyReady = true;

        await Session.LoadUserAsync();

        var token = Session.CurrentUser?.SpotifyAccessToken;

        Console.WriteLine($"TOKEN: {token}");

        if (!string.IsNullOrEmpty(token))
        {
            await JS.InvokeVoidAsync("initializeSpotifyPlayer", token);

            // small delay ensures deviceId exists
            await Task.Delay(1000);

            await JS.InvokeVoidAsync("transferPlayback", token);
        }
    
    
        if (isSearchModalOpen)
        {
            await JS.InvokeVoidAsync("focusSearch");
        }
    }

    private async Task Recalibrate()
    {
        // await MoodCalibrationService.RecalibrateAsync();
        // recalibrationRequired = false;
        //moodResult = await MoodCalibrationService.BuildMoodResultAsync();
        moodResult = await MoodCalibrationService.RecalibrateAsync();
    }

    /// <summary>
    /// This method is called when the inactivity timer elapses.
    /// </summary>
    /// <param name="sender"></param>
    /// <param name="e"></param>
    private void OnInactivityElapsed(object sender, System.Timers.ElapsedEventArgs e)
    {
        InvokeAsync(() =>
        {
            // Show prompt to the user
            Console.WriteLine("Hey! It's been a while. How about playing a music track or searching for your mood?");
        });
    }

    /// <summary>
    /// This method resets the inactivity timer.
    /// </summary>
    private void ResetInactivityTimer()
    {
        inactivityTimer!.Stop();
        inactivityTimer.Start();
    }

    /// <summary>
    /// This method is called when the component is disposed.
    /// </summary>
    public void Dispose()
    {
        inactivityTimer?.Dispose();
    }


    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await TriggerSearch();
        }
    }

    /// <summary>
    /// This method is called when the search box is clicked.
    /// </summary>
    private void OnSearchBoxClicked()
    {
        ResetInactivityTimer();
    }

    private void SelectTrack(Item track)
    {
        searchTerm = track.Name!;
        searchResults.Clear();
        selectedTrack = track;
       // selectedTrack = moodResult.RecommendedTracks?.FirstOrDefault();
        //CloseSearchModal();
    }

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";

        _cts?.Cancel();
        _cts = new CancellationTokenSource();

        try
        {
            await Task.Delay(400, _cts.Token); // 400ms debounce


            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                isLoading = true;
                var results = await Spotify.Search(searchTerm, "track");

                searchResults = results.Tracks?.Items?.ToList()
                                ?? new List<Item>();
                isLoading = false;

                // selectedTrack = null;  
                // searchResults.Clear();
                // return;

            }
            else
            {
                searchResults.Clear();
            }
        }
        catch (TaskCanceledException)
        {
            // User kept typing — ignore
        }
    }

    private string SearchTerm
    {
        get => searchTerm;
        set
        {
            searchTerm = value;
            FilterTracks();
        }
    }

    private void FilterTracks()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredTracks!.Clear();
            return;
        }

        // filteredTracks = allTracks?
        //     .Where(t => t.Name!.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        //     .Take(8)
        //     .ToList();
    }

    @* Search box *@
    private string searchQuery = string.Empty;

    // searchQuery.Contains("happy") || searchQuery.Contains("joy") || searchQuery.Contains("excited") ? "Happy" : "Sad" : "Relaxed" : "Energetic";

    private bool isSearchModalOpen = false;

    /// <summary>
    /// This method is called to open the search modal.
    /// </summary>
    private void OpenSearchModal()
    {
        // Console.WriteLine("OPEN CLICKED");
        isSearchModalOpen = true;
    }

    /// <summary>
    /// This method is called to close the search modal.
    /// </summary>
    private void CloseSearchModal()
    {
        isSearchModalOpen = false;
    }

    /// <summary>
    /// The TrackView m
    /// </summary>
    private enum TrackViewMode
    {
        List,
        Gallery
    }

    private TrackViewMode currentView = TrackViewMode.Gallery;

    private void SetView(TrackViewMode mode)
    {
        currentView = mode;
    }

    /// <summary>
    /// The <c>ConfirmMood</c> method is called when the user confirms that they want to listen to music based on their detected mood.
    /// </summary>
    /// <returns></returns>
    private async Task ConfirmMood()
    {
        showMoodPrompt = false;

        searchTerm = detectedMood;
        var results = await Spotify.Search(searchTerm, "track");
        searchResults = results.Tracks?.Items?.ToList()
                        ?? new();
    }

    private void RejectMood()
    {
        showMoodPrompt = false;

        // Option 1: open search modal
        isSearchModalOpen = true;

        // Option 2: show alternative moods
        suggestedMoods = new List<string> { "Energetic", "Workout", "Focus" };
    }

    private List<string> suggestedMoods = new()
    {
        "Calm", "Happy", "Focus"
    };

    // private void DisplayArtist(MouseEventArgs args)
    // {
    //     throw new NotImplementedException();
    // }
    private async Task TriggerSearch()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
            return;

        isLoading = true;

        var results = await Spotify.Search(searchTerm, "track");

        searchResults = results.Tracks?.Items?.ToList()
                        ?? new List<Item>();

        isLoading = false;
    }

    private UiTrack MapFromItem(Item item)
    {
        return new UiTrack
        {
            Id = item.Id!,
            Name = item.Name!,
            Artist = item.Artists?.FirstOrDefault()?.Name ?? "",
            ImageUrl = item?.Images?.FirstOrDefault()?.Url
        };
    }

    private UiTrack MapFromTrack(Track track)
    {
        return new UiTrack
        {
            Id = track.Id!,
            Name = track.Name!,
            Artist = track.Artists?.FirstOrDefault()?.Name ?? "",
            ImageUrl = track.Album?.Images?.FirstOrDefault()?.Url
        };
    }
}

