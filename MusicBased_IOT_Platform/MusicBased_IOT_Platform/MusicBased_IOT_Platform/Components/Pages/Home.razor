@* prompt the user to perform an action if the system has been left inactive after 30 secs i.e. "Play a music track!" or "Search for your mood!" *@
@code {
    private System.Timers.Timer? inactivityTimer;

    /// <summary>
    /// This method is called when the component is initialised.
    /// </summary>
    protected override void OnInitialized()
    {
        inactivityTimer = new System.Timers.Timer(30000); // 30 seconds
        inactivityTimer.Elapsed += OnInactivityElapsed!;
        inactivityTimer.AutoReset = false; // Only trigger once
        inactivityTimer.Start();
    }

    /// <summary>
    /// This method is called when the inactivity timer elapses.
    /// </summary>
    /// <param name="sender"></param>
    /// <param name="e"></param>
    private void OnInactivityElapsed(object sender, System.Timers.ElapsedEventArgs e)
    {
        InvokeAsync(() =>
        {
            // Show prompt to the user
            Console.WriteLine("Hey! It's been a while. How about playing a music track or searching for your mood?");
        });
    }

    /// <summary>
    /// This method resets the inactivity timer.
    /// </summary>
    private void ResetInactivityTimer()
    {
        inactivityTimer!.Stop();
        inactivityTimer.Start();
    }

    /// <summary>
    /// This method is called when the component is disposed.
    /// </summary>
    public void Dispose()
    {
        inactivityTimer?.Dispose();
    }

    /// <summary>
    /// This method is called when the search box is clicked.
    /// </summary>
    private void OnSearchBoxClicked()
    {
        ResetInactivityTimer();
    }

    @* Search box *@
    private string searchQuery = string.Empty;

    // searchQuery.Contains("happy") || searchQuery.Contains("joy") || searchQuery.Contains("excited") ? "Happy" : "Sad" : "Relaxed" : "Energetic";

}
