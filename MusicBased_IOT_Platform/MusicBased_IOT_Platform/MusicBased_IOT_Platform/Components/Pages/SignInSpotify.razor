@page "/signin-spotify"
@using MusicBased_IOT_Platform.Application.Interfaces.Fitbit
@using MusicBased_IOT_Platform.Application.Interfaces.Spotify
@using MusicBased_IOT_Platform.Application.Services
@using MusicBased_IOT_Platform.Models
@inject ISpotifyDataService SpotifyService
@inject UserSessionService Session
@inject NavigationManager Navigation
@rendermode InteractiveServer

<br />
<br />
<h1>Sign In To Spotify</h1>

@code {

    protected override async Task OnInitializedAsync()
    {
        await Session.LoadUserAsync();

        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var code = query["code"];

        Console.WriteLine("SPOTIFY CALLBACK HIT");
        Console.WriteLine($"URL: {Navigation.Uri}");
        Console.WriteLine($"CODE: {code}");

        if (!string.IsNullOrEmpty(code))
        {
            if (Session.CurrentUser == null)
            {
                // no user logged in, therefore cannot access spotify
                Navigation.NavigateTo("/login");
                return;
            }

            // Exchange the authorization code for an access token
            // await SpotifyService.ExchangeCodeAsync(code, Session.CurrentUser!.ID);
            await SpotifyService.ExchangeCodeAsync(code, Session.CurrentUser!.ID);
            Navigation.NavigateTo("/dashboard");
            return;
        }
    }
  
}