    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("loadData", 7);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"JS ERROR: {ex.Message}");
            }
        }
    }
    private async Task OnRangeChange(ChangeEventArgs e)
{
    if (JS == null) return;

    var days = int.Parse(e.Value!.ToString()!);

    await JS.InvokeVoidAsync("loadData", days);
}


    }
