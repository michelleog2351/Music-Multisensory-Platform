@page "/dashboard"
@using MusicBased_IOT_Platform.Application.Services
@inject IJSRuntime JS
@inject UserSessionService Session
@inject NavigationManager NavigationManager

<br />
<br />
<h3>My Dashboard (Biometric Trends)</h3>

<PageTitle>My Dashboard</PageTitle>
<p>Session User: @Session.CurrentUser?.FirstName</p>

<br />
<select @onchange="OnRangeChange" class="form-control">
    <option value="7">Daily</option>
    <option value="14">Weekly</option>
    <option value="30">Monthly</option>
</select>

<br />

@* d3 barchart *@
<div id="myChart" 
     width="400" 
     height="600"
     class="d-flex justify-content-center">
</div>

<div 
    id="tooltip" 
    style="
    position:absolute;
    display:none;
    background:#eee;
    padding:10px;
    border:1px solid #ccc;
    border-radius: 25px">
</div>

@* <script>
    function OnRangeChange(days) {
        loadData(days);
    }

    loadData(); 
</script> *@

@code {

    // protected override void OnAfterRender(bool firstRender)
    // {
    //     if (firstRender && Session.CurrentUser != null)
    //     {
    //         NavigationManager.NavigateTo("/dashboard", true);
    //     }
    // }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("loadData", 7);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"JS ERROR: {ex.Message}");
            }
        }
    }
    private async Task OnRangeChange(ChangeEventArgs e)
{
    if (JS == null) return;

    var days = int.Parse(e.Value!.ToString()!);

    await JS.InvokeVoidAsync("loadData", days);
}


}
