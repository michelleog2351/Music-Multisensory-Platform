@page "/dashboard"
@using MusicBased_IOT_Platform.Application.Services
@inject IJSRuntime JS

 @inject UserSessionService Session
@inject NavigationManager NavigationManager

@* <script src="https://d3js.org/d3.v7.min.js"></script>
<script src="/js/dashboard.js"></script> *@

<h3>My Dashboard (Biometric Trends)</h3>

<PageTitle>My Dashboard</PageTitle>
<p>Session User: @Session.CurrentUser?.FirstName</p>

<br />
<select @onchange="OnRangeChange" class="form-control">
    <option value="7">Daily</option>
    <option value="14">Weekly</option>
    <option value="30">Monthly</option>
</select>



@* d3 barchart *@
<div id="myChart" 
            width="400" 
            height="200">
</div>

<div id="tooltip" style="
    position:absolute;
    display:none;
    background:#eee;
    padding:10px;
    border:1px solid #ccc;">
</div>

@* <script>
    function OnRangeChange(days) {
        loadData(days);
    }

    loadData(); 
</script> *@

@code {

    // protected override void OnAfterRender(bool firstRender)
    // {
    //     if (firstRender && Session.CurrentUser != null)
    //     {
    //         NavigationManager.NavigateTo("/dashboard", true);
    //     }
