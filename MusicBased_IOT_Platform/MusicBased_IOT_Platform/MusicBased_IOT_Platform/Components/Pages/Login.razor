@page "/login"
@using Microsoft.EntityFrameworkCore
@using MusicBased_IOT_Platform.Data
@using MusicBased_IOT_Platform.Models
@rendermode InteractiveServer
@inject AppDBContext dB
@inject NavigationManager NavigationManager

<PageTitle>Login</PageTitle>

 <div class="container d-flex justify-content-center align-items-center flex-grow-1">
    <div class="card p-4 mt-5 shadow rounded-4"
         style="max-width: 600px; width: 100%">
         <br />
        <h2 class="text-center">Login</h2>

         <EditForm Model="@loginModel"
            OnValidSubmit="HandleLogin"
            FormName="loginForm">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="card-body">
                    <div class="mb-3">
                        <InputText 
                               class="form-control"  
                               type="text" 
                               required
                               @bind-Value="loginModel.Username"
                               placeholder="Username"
                               autocomplete="on" />
                    </div>

                    <div class="mb-3">
                        <InputText class="form-control"  
                                   type="password"
                                   required
                                   @bind-Value="loginModel.Password"
                                   placeholder="Password" />
                    </div>
           
                    <div>
                        <InputCheckbox 
                            @bind-Value="loginModel.RememberMe" /> Remember me
                    </div>
                    
                    <br />
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    @ErrorMessage
                </div>
            }
                    <div class="d-grid gap-2">
                        <button class="btn btn-primary btn-lg" type="submit">Login</button>
                    </div>
            </div>
            </EditForm>
    </div>
 </div>
@code 
{
    // public string? Username { get; set; } = string.Empty;
    // public string? Password { get; set; } = string.Empty;

    private LoginModel loginModel = new();

    private string? ErrorMessage;

    /// <summary>
    /// The HandleLogin method
    /// </summary>
    /// <returns></returns>
    private async Task HandleLogin()
    {
        var user = await dB.Users
            .FirstOrDefaultAsync(u => u.Username == loginModel.Username);

        if (user == null)
        {
            ErrorMessage = "Invalid username.";
            return;
        }

        bool validPassword = BCrypt.Net.BCrypt.Verify(loginModel.Password, user.PasswordHash);

        if (!validPassword)
        {
            ErrorMessage = "Invalid password.";
            return;
        }

        NavigationManager.NavigateTo("/");
    }
}
