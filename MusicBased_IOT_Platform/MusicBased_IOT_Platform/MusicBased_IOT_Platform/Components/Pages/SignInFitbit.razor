    private bool _hasRun = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _hasRun)
            return;

        _hasRun = true;

        await Session.LoadUserAsync();

        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var code = query["code"];

        Console.WriteLine("🔥 SIGNIN-FITBIT PAGE HIT");
        Console.WriteLine($"URL: {Navigation.Uri}");
        Console.WriteLine($"CODE: {code}");

        if (!string.IsNullOrEmpty(code))
        {
            if (Session.CurrentUser == null)
            {
                Console.WriteLine("❌ USER STILL NULL AFTER LOAD");

                Navigation.NavigateTo("/login");
                return;
            }

            Console.WriteLine($"✅ USER: {Session.CurrentUser.Username}");

            await FitbitService.AuthCodeFlowAsync(code, Session.CurrentUser.ID);

            Navigation.NavigateTo("/dashboard", true);
        }
    }

    private async Task ConnectToFitbit()
    {
        await Session.LoadUserAsync();

        if (Session.CurrentUser == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }


        var url = FitbitService.GetFitbitAuthUrl();
        Navigation.NavigateTo(url, true);   
    }
}