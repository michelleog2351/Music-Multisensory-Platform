@page "/signin-fitbit"
@using MusicBased_IOT_Platform.Application.Interfaces.Fitbit
@using MusicBased_IOT_Platform.Application.Services
@using MusicBased_IOT_Platform.Models
@inject UserSessionService Session
@inject IFitbitDataService FitbitService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<h1>Sign In To Fitbit</h1>

@code {

    protected override async Task OnInitializedAsync()
    {
        await Session.LoadUserAsync();

        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var code = query["code"];

        if (!string.IsNullOrEmpty(code))
        {
            if (Session.CurrentUser == null)
            {
                // no user logged in, therefore cannot access fitbit
                Navigation.NavigateTo("/login");
                return;
            }

            // Exchange the authorization code for an access token, pass user ID
            await FitbitService.AuthCodeFlowAsync(code, Session.CurrentUser.ID);

            Navigation.NavigateTo("/dashboard");
            return;
        }
    }
}