@using MusicBased_IOT_Platform.Application.Services
@inject UserSessionService Session
@inject NavigationManager NavigationManager
@implements IDisposable


<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">

        <a class="navbar-brand" href="">
            MusicBased_IOT_Platform
        </a>

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainNavbar"
                aria-controls="mainNavbar"
                aria-expanded="false"
                aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNavbar">
            <p style="color:yellow">
                DEBUG USER: @(Session.CurrentUser?.FirstName ?? "NULL")
            </p>

            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">Home
                    </NavLink>
                </li>
                @if (Session.CurrentUser != null)
                {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="dashboard">
                            My Dashboard
                        </NavLink>
                    </li>
                }

            </ul>

            <ul class="navbar-nav ms-auto">
               @if (Session.CurrentUser == null)
               {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="login">Login
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="register">Register
                        </NavLink>
                    </li>
               }
               else
               {

                    <li class="nav-item">
                        <span class="navbar-text me-3">
                            <b>
                            Hi @Session.CurrentUser.FirstName!
                            </b>
                        </span>
                    </li>

                    <li class="nav-item">
                        <button class="btn btn-outline-light btn-sm" 
                        @onclick="OpenLogoutModal">
                            Logout
                        </button>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

@if (showLogoutModal)
{
    <div class="modal fade show d-block" tabindex="-1" @onclick="CloseLogoutModal">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content rounded-4 shadow">

                <div class="modal-header">
                    <h5 class="modal-title"><b>Confirm Logout</b></h5>
                    <button class="btn-close" @onclick="CloseLogoutModal"></button>
                </div>

                <div class="modal-body text-center">
                    <p class="mb-0">
                        Are you sure you want to log out?
                    </p>
                </div>

                <div class="modal-footer border-0 d-flex justify-content-center gap-3">

                    <button class="btn btn-link text-muted px-2"
                    style="text-decoration: none;"
                            @onclick="CloseLogoutModal">
                        <b>Cancel</b>
                    </button>

                    <button class="btn btn-spotify px-4"
                            @onclick="ConfirmLogout">
                        Confirm
                    </button>

                </div>

            </div>
        </div>
    </div>

    <!-- Backdrop -->
    <div class="modal-backdrop fade show"></div>
}

@code {

    /// <summary>
    /// The OnInitialized method is overridden to subscribe to the UserSessionService's OnChange event.
    /// </summary>
    // protected override void OnInitialized()
    // {
    //     Session.OnChange += async () => await InvokeAsync(StateHasChanged);
    private bool showLogoutModal = false;

    // }
    protected override async Task OnInitializedAsync()
    {
        Session.OnChange += async () => await InvokeAsync(StateHasChanged);
        await Session.LoadUserAsync();

        StateHasChanged();
    }

    /// <summary>
    /// The Dispose method is implemented to unsubscribe from the UserSessionService's OnChange event 
    /// when the component is disposed, preventing memory leaks.
    /// </summary>
    public void Dispose()
    {
        Session.OnChange -= StateHasChanged;
    }

    /// <summary>
    /// The Logout method is responsible for logging the user out of the application.
    /// </summary>
    /// <returns></returns>
    // private async Task Logout()
    // {
    //     await Session.LogoutAsync();
    //     NavigationManager.NavigateTo("/login", true);
    // }

    private void OpenLogoutModal()
    {
        showLogoutModal = true;
    }

    private void CloseLogoutModal()
    {
        showLogoutModal = false;
    }

    private async Task ConfirmLogout()
    {
        await Session.LogoutAsync(); 
        NavigationManager.NavigateTo("/login", true);
    }
}

