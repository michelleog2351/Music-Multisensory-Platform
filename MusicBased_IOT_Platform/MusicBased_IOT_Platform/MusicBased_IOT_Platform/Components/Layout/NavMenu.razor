@using MusicBased_IOT_Platform.Application.Services
@inject NavigationManager NavigationManager
@inject UserSessionService Session

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            MusicBased_IOT_Platform
        </a>

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainNavbar"
                aria-controls="mainNavbar"
                aria-expanded="false"
                aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNavbar">

            <! -- Show the user's first name if logged in, otherwise show "Login" -->
            @if (Session.CurrentUser != null)
            {
                <span>Hi @Session.CurrentUser.FirstName</span>
            }
            else
            {
                <span>Login</span>
            }

            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">Home
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link" href="dashboard">
                        My Dashboard
                    </NavLink>
                </li>
            </ul>

            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <NavLink class="nav-link" href="login">Login
                    </NavLink>
                </li>

                <button @onclick="Logout">Logout</button>

                <li class="nav-item">
                    <NavLink class="nav-link" href="register">Register
                    </NavLink>
                </li>
            </ul>
        </div>
    </div>
</nav>

@Session.CurrentUser != null
{
    <div class="container mt-3">
        <div class="alert alert-success" role="alert">
            Welcome back, @Session.CurrentUser!.FirstName!
        </div>
    </div>
}

@code {
    private void Logout()
    {
        Session.Logout();
        NavigationManager.NavigateTo("/login");
    }
}

