@using MusicBased_IOT_Platform.Application.Services
@inject UserSessionService Session
@inject NavigationManager NavigationManager


<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">

        <a class="navbar-brand" href="">
            MusicBased_IOT_Platform
        </a>

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainNavbar"
                aria-controls="mainNavbar"
                aria-expanded="false"
                aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNavbar">

         @*    <! -- Show the user's first name if logged in, otherwise show "Login" -->
            @if (Session.CurrentUser != null)
            {
                <span>Hi @Session.CurrentUser.FirstName</span>
            }
            else
            {
                <span>Login</span>
            }
 *@
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">Home
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link" href="dashboard">
                        My Dashboard
                    </NavLink>
                </li>
            </ul>

            <ul class="navbar-nav ms-auto">
               @if (Session.CurrentUser == null)
               {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="login">Login
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="register">
                            Register
                        </NavLink>
                    </li>
               }
               else
               {
                    <li class="nav-item dropdown">

                        <a class="nav-link dropdown-toggle"
                            href="#"
                            role="button"
                            data-bs-toggle="dropdown">

                            Hi @Session.CurrentUser.FirstName

                        </a>

                        <ul class="dropdown-menu dropdown-menu-end">

                            <li>
                                <NavLink class="dropdown-item" href="dashboard">Dashboard
                                </NavLink>
                            </li>

                            <li>
                                <button class="dropdown-item" @onclick="Logout">
                                Logout
                                </button>
                            </li>
                        </ul>
                    </li>
               }
            </ul>
        </div>
    </div>
</nav>

@code {

    /// <summary>
    /// The OnInitialized method is overridden to subscribe to the UserSessionService's OnChange event.
    /// </summary>
    protected override void OnInitialized()
    {
        Session.OnChange += StateHasChanged;
    }

    /// <summary>
    /// The Dispose method is implemented to unsubscribe from the UserSessionService's OnChange event 
    /// when the component is disposed, preventing memory leaks.
    /// </summary>
    public void Dispose()
    {
        Session.OnChange -= StateHasChanged;
    }



    /// <summary>
    /// The Logout method is responsible for logging the user out of the application.
    /// </summary>
    /// <returns></returns>
    private async Task Logout()
    {
        await Session.LogoutAsync();
        NavigationManager.NavigateTo("/login");
    }
}

